# Caching proxy for OpenStreetMap's standard tiles at /tiles/{z}/{x}/{y}.png (Caddy forwards
# /tiles/* here). OSM tile usage policy: https://operations.osmfoundation.org/policies/tiles/
# ${TILES_*} values are filled in from compose.yml at container start.

load_module modules/ngx_http_js_module.so;

user nginx;
worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    types {}
    default_type text/plain;
    server_tokens off;
    # Caddy sets X-Real-IP to the visitor's address and nothing else can reach this service.
    log_format tiles '$http_x_real_ip "$request" $status $body_bytes_sent cache=$upstream_cache_status '
                     'upstream=$upstream_status ${request_time}s';
    access_log /dev/stdout tiles;

    js_path /etc/nginx/templates;
    js_import tiles from tiles.js;

    # Docker's embedded DNS; re-resolves the OSM CDN as its addresses change.
    resolver 127.0.0.11 valid=300s ipv6=off;

    upstream osm {
        zone osm 64k;
        server tile.openstreetmap.org:443 resolve;
        keepalive 8;
    }

    proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:64m
                     max_size=${TILES_CACHE_MAX_SIZE} inactive=${TILES_CACHE_INACTIVE} use_temp_path=off;

    limit_req_zone $http_x_real_ip zone=tiles_per_ip:10m rate=${TILES_RATE_PER_SECOND}r/s;
    limit_req_status 429;

    server {
        listen 80;

        location ~ "^/tiles/(?<tile_z>[0-9]|1[0-9])/(?<tile_x>[0-9]{1,6})/(?<tile_y>[0-9]{1,6})\.png$" {
            js_set $tile_ok tiles.ok;

            add_header Access-Control-Allow-Origin * always;
            add_header Cross-Origin-Resource-Policy cross-origin always;
            add_header X-Cache-Status $upstream_cache_status always;

            if ($request_method = OPTIONS) {
                add_header Access-Control-Allow-Origin * always;
                add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
                add_header Access-Control-Max-Age 86400 always;
                return 204;
            }
            if ($request_method !~ ^(GET|HEAD)$) {
                return 405;
            }
            if ($tile_ok = "") {
                return 404 "No such tile\n";
            }

            # Bursty on purpose: a map view loads a few dozen tiles at once.
            limit_req zone=tiles_per_ip burst=${TILES_RATE_BURST} nodelay;

            proxy_pass https://osm/$tile_z/$tile_x/$tile_y.png;
            proxy_http_version 1.1;
            proxy_ssl_server_name on;
            proxy_ssl_name tile.openstreetmap.org;
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
            proxy_connect_timeout 5s;
            proxy_read_timeout 15s;
            proxy_next_upstream_tries 2;

            # Only these headers go upstream; the visitor's cookies, referer and address do not.
            proxy_pass_request_headers off;
            proxy_set_header Host tile.openstreetmap.org;
            proxy_set_header Connection "";
            proxy_set_header User-Agent "whereplane.xyz-tile-proxy/1.0 (+https://whereplane.xyz)";
            proxy_set_header Referer "https://whereplane.xyz/";
            proxy_set_header Accept "image/png";

            proxy_cache tiles;
            proxy_cache_key $tile_z/$tile_x/$tile_y;
            # Upstream Cache-Control/Expires decide freshness; these apply only when it sends none.
            proxy_cache_valid 200 1d;
            proxy_cache_valid 404 1h;
            # Refresh expired tiles with If-None-Match/If-Modified-Since, one request per tile at a time.
            proxy_cache_revalidate on;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 10s;
            # Keep serving a cached tile when OSM fails, throttles or blocks us.
            proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503 http_504;
            proxy_cache_background_update on;
            # OSM answers a blocked request with 200 and an "Access blocked" image; never keep one.
            proxy_no_cache $upstream_http_x_blocked;
            proxy_ignore_headers Set-Cookie;
            proxy_hide_header Set-Cookie;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header X-Cache;
            proxy_hide_header X-Cache-Hits;
        }

        location / {
            add_header Access-Control-Allow-Origin * always;
            return 400 "Expected /tiles/{z}/{x}/{y}.png with z 0..19\n";
        }
    }
}
